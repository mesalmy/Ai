    ];

    let appState = {
      targetCapital: 7070,
      currentDate: '2026-10-16',
      managerName: 'مسؤول البوفيه',
      cashReserve: 0,
      items: JSON.parse(JSON.stringify(DEFAULT_ITEMS_16_10_2026)),
      history: [],
      invoices: [],
