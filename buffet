    let currentAnalyticsMode = 'daily';
    let tempInvoiceImageBase64 = '';

    window.addEventListener('DOMContentLoaded', async () => {
      loadStateFromStorage();
      syncInputsWithState();
      renderInventoryTable();
      renderHistoryLog();
      renderInvoices();
      renderAnalytics();
      await autoConnectFirebaseOnStart();
    });

    function syncInputsWithState() {
      document.getElementById('currentDateInput').value = appState.currentDate || '2026-10-16';
      document.getElementById('managerNameInput').value = appState.managerName || 'مسؤول البوفيه';
      document.getElementById('cashReserveInput').value = appState.cashReserve || 0;
      document.getElementById('targetCapitalInput').value = appState.targetCapital || 7070;
      document.getElementById('headerTargetCapital').innerText = Number(appState.targetCapital || 7070).toLocaleString();
      document.getElementById('fbDbUrlInput').value = appState.firebaseUrl || DEFAULT_FIREBASE_URL;
      document.getElementById('fbShopKeyInput').value = appState.firebaseShopKey || DEFAULT_SHOP_KEY;
    }

    function fmt(num, decimals = 2) {
      return Number(num || 0).toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: 3 });
    }

    function renderInventoryTable() {
      const tbody = document.getElementById('inventoryTableBody');
      const query = (document.getElementById('searchItemInput')?.value || '').trim().toLowerCase();
      tbody.innerHTML = '';

      appState.items.forEach((item, index) => {
        if (query && !item.name.toLowerCase().includes(query)) return;
        const sold = Number(item.sold || 0);
        const remaining = Number(item.remaining || 0);
        const totalSales = sold * Number(item.sellPrice || 0);
        const soldCapital = sold * Number(item.buyPrice || 0);
        const netProfit = totalSales - soldCapital;
        const remainingValue = remaining * Number(item.buyPrice || 0);
        const isOut = remaining <= 0;

        const tr = document.createElement('tr');
        tr.className = `hover:bg-slate-800/50 transition ${isOut ? 'bg-rose-950/15' : ''}`;
        tr.innerHTML = `
          <td class="py-2.5 px-2.5 text-slate-400 font-bold">${index + 1}</td>
          <td class="py-2.5 px-3 font-bold text-white">${item.name}</td>
          <td class="py-2.5 px-2 text-center text-slate-300 font-mono">${fmt(item.buyPrice)}</td>
          <td class="py-2.5 px-2 text-center text-white font-mono font-bold">${fmt(item.sellPrice)}</td>
          <td class="py-2 px-1.5"><input type="number" value="${item.initial}" oninput="onQtyChange(${item.id}, 'initial', this.value)" class="input-num" /></td>
          <td class="py-2 px-1.5"><input type="number" value="${item.added}" oninput="onQtyChange(${item.id}, 'added', this.value)" class="input-num !text-blue-300" /></td>
          <td class="py-2 px-1.5"><input type="number" id="remInput_${item.id}" value="${item.remaining}" oninput="onQtyChange(${item.id}, 'remaining', this.value)" class="input-num !text-purple-300" /></td>
          <td class="py-2 px-1.5"><input type="number" id="soldInput_${item.id}" value="${item.sold}" oninput="onQtyChange(${item.id}, 'sold', this.value)" class="input-num !text-amber-300" /></td>
          <td class="py-2.5 px-2 text-center font-bold text-white font-mono" id="rowSales_${item.id}">${fmt(totalSales)}</td>
          <td class="py-2.5 px-2 text-center font-black text-emerald-400 font-mono" id="rowProfit_${item.id}">${fmt(netProfit)}</td>
          <td class="py-2.5 px-2 text-center font-bold text-amber-300 font-mono" id="rowSoldCap_${item.id}">${fmt(soldCapital)}</td>
          <td class="py-2.5 px-2 text-center font-bold text-purple-300 font-mono" id="rowRemVal_${item.id}">${fmt(remainingValue)}</td>
          <td class="py-2.5 px-2 text-center no-print">
            <div class="flex items-center justify-center gap-1">
              <button onclick="openProductModal(${item.id})" class="p-1.5 rounded-lg bg-slate-800 text-slate-300"><i class="fa-solid fa-pen text-[11px]"></i></button>
              <button onclick="deleteProduct(${item.id})" class="p-1.5 rounded-lg bg-rose-950/50 text-rose-300"><i class="fa-solid fa-trash text-[11px]"></i></button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
      recalculateAll(false);
    }

    function onQtyChange(itemId, field, rawVal) {
      const item = appState.items.find(i => i.id === itemId);
      if (!item) return;
      item[field] = Math.max(0, Number(rawVal || 0));
      const totalAvail = Number(item.initial || 0) + Number(item.added || 0);

      if (field === 'remaining') {
        item.sold = Math.max(0, totalAvail - item.remaining);
        const sEl = document.getElementById(`soldInput_${item.id}`);
        if (sEl) sEl.value = item.sold;
      } else {
        item.remaining = Math.max(0, totalAvail - item.sold);
        const rEl = document.getElementById(`remInput_${item.id}`);
        if (rEl) rEl.value = item.remaining;
      }

      const totalSales = item.sold * item.sellPrice;
      const soldCapital = item.sold * item.buyPrice;
      document.getElementById(`rowSales_${item.id}`).innerText = fmt(totalSales);
      document.getElementById(`rowProfit_${item.id}`).innerText = fmt(totalSales - soldCapital);
      document.getElementById(`rowSoldCap_${item.id}`).innerText = fmt(soldCapital);
      document.getElementById(`rowRemVal_${item.id}`).innerText = fmt(item.remaining * item.buyPrice);
      recalculateAll(true);
    }

    function recalculateAll(shouldSave = true) {
      let sumInitial = 0, sumAdded = 0, sumRemQty = 0, sumSoldQty = 0;
      let sumSales = 0, sumProfit = 0, sumSoldCap = 0, sumRemVal = 0;

      appState.items.forEach(item => {
        const sold = Number(item.sold || 0);
        const rem = Number(item.remaining || 0);
        const sales = sold * Number(item.sellPrice || 0);
        const soldCap = sold * Number(item.buyPrice || 0);
        sumInitial += Number(item.initial || 0);
        sumAdded += Number(item.added || 0);
        sumRemQty += rem;
        sumSoldQty += sold;
        sumSales += sales;
        sumProfit += (sales - soldCap);
        sumSoldCap += soldCap;
        sumRemVal += (rem * Number(item.buyPrice || 0));
      });

      appState.cashReserve = Number(document.getElementById('cashReserveInput')?.value || 0);
      const targetCap = Number(appState.targetCapital || 7070);
      const requiredPurchase = Math.max(0, targetCap - sumRemVal);
      const actualCapitalTotal = sumRemVal + sumSoldCap + appState.cashReserve;
      const capitalDiff = actualCapitalTotal - targetCap;

      document.getElementById('cardTotalSales').innerText = `${fmt(sumSales)} ج`;
      document.getElementById('cardNetProfit').innerText = `${fmt(sumProfit)} ج`;
      document.getElementById('cardSoldCapital').innerText = `${fmt(sumSoldCap)} ج`;
      document.getElementById('cardRemainingStockValue').innerText = `${fmt(sumRemVal)} ج`;
      document.getElementById('cardRequiredPurchase').innerText = `${fmt(requiredPurchase)} ج`;

      document.getElementById('footTotalInitial').innerText = sumInitial;
      document.getElementById('footTotalAdded').innerText = sumAdded;
      document.getElementById('footTotalRemainingQty').innerText = sumRemQty;
      document.getElementById('footTotalSoldQty').innerText = sumSoldQty;
      document.getElementById('footTotalSales').innerText = fmt(sumSales);
      document.getElementById('footTotalProfit').innerText = fmt(sumProfit);
      document.getElementById('footTotalSoldCap').innerText = fmt(sumSoldCap);
      document.getElementById('footTotalRemVal').innerText = fmt(sumRemVal);

      document.getElementById('totalActualCapitalDisplay').innerText = `${fmt(actualCapitalTotal)} ج.م`;
      const diffBadge = document.getElementById('capitalDiffBadge');
      diffBadge.className = 'mr-2 px-2.5 py-0.5 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-300';
      diffBadge.innerText = Math.abs(capitalDiff) < 1 ? 'مضبوط بالمللي' : `الفرق عن المستهدف: ${fmt(capitalDiff)} ج`;

      renderShoppingList(requiredPurchase);
      renderAnalytics();
      if (shouldSave) saveCurrentState();
    }

    function calcUnitFromCarton() {
      const cp = Number(document.getElementById('prodCartonPrice').value || 0);
      const cu = Number(document.getElementById('prodCartonUnits').value || 0);
      if (cp > 0 && cu > 0) {
        document.getElementById('prodBuyPrice').value = +(cp / cu).toFixed(3);
        updateUnitProfitPreview();
      }
    }

    function updateUnitProfitPreview() {
      const b = Number(document.getElementById('prodBuyPrice').value || 0);
      const s = Number(document.getElementById('prodSellPrice').value || 0);
      document.getElementById('prodProfitPreview').innerText = `${fmt(s - b)} ج.م`;
    }

    function openProductModal(editId = null) {
      if (editId) {
        const item = appState.items.find(i => i.id === editId);
        if (!item) return;
        document.getElementById('editProductId').value = item.id;
        document.getElementById('prodName').value = item.name;
        document.getElementById('prodBuyPrice').value = item.buyPrice;
        document.getElementById('prodSellPrice').value = item.sellPrice;
        document.getElementById('prodInitialQty').value = item.initial;
        document.getElementById('prodAddedQty').value = item.added;
        document.getElementById('prodRemainingQty').value = item.remaining;
      } else {
        document.getElementById('editProductId').value = '';
        document.getElementById('prodName').value = '';
        document.getElementById('prodBuyPrice').value = '';
        document.getElementById('prodSellPrice').value = '';
        document.getElementById('prodInitialQty').value = 0;
        document.getElementById('prodAddedQty').value = 0;
        document.getElementById('prodRemainingQty').value = 0;
      }
      openModal('productModal');
    }

    function saveProductFromModal() {
      const name = document.getElementById('prodName').value.trim();
      const buyPrice = Number(document.getElementById('prodBuyPrice').value || 0);
      const sellPrice = Number(document.getElementById('prodSellPrice').value || 0);
      const initial = Number(document.getElementById('prodInitialQty').value || 0);
      const added = Number(document.getElementById('prodAddedQty').value || 0);
      const remaining = Number(document.getElementById('prodRemainingQty').value || 0);
      if (!name || buyPrice <= 0 || sellPrice <= 0) return alert('أدخل البيانات بشكل صحيح');

      const sold = Math.max(0, (initial + added) - remaining);
      const editId = document.getElementById('editProductId').value;
      if (editId) {
        const item = appState.items.find(i => i.id == editId);
        if (item) Object.assign(item, { name, buyPrice, sellPrice, initial, added, remaining, sold });
      } else {
        appState.items.push({ id: Date.now(), name, buyPrice, sellPrice, initial, added, remaining, sold, cartonUnits: 12 });
      }
      closeModal('productModal');
      renderInventoryTable();
      saveCurrentState();
    }

    function deleteProduct(id) {
      if (confirm('حذف هذا الصنف؟')) {
        appState.items = appState.items.filter(i => i.id !== id);
        renderInventoryTable();
        saveCurrentState();
      }
    }

    function quickAddCartonModal() {
      document.getElementById('restockItemSelect').innerHTML = appState.items.map(i => `<option value="${i.id}">${i.name}</option>`).join('');
      openModal('cartonRestockModal');
    }

    function applyCartonRestock() {
      const itemId = Number(document.getElementById('restockItemSelect').value);
      const cartons = Number(document.getElementById('restockCartonCount').value || 0);
      const units = Number(document.getElementById('restockUnitsPerCarton').value || 0);
      const item = appState.items.find(i => i.id === itemId);
      if (item && cartons > 0 && units > 0) {
        item.added += cartons * units;
        item.remaining += cartons * units;
        closeModal('cartonRestockModal');
        renderInventoryTable();
        saveCurrentState();
      }
    }

    function saveTargetCapital() {
      appState.targetCapital = Number(document.getElementById('targetCapitalInput').value || 7070);
      document.getElementById('headerTargetCapital').innerText = appState.targetCapital.toLocaleString();
      closeModal('capitalModal');
      recalculateAll(true);
    }

    function openCloseDayModal() {
      let sumSales = 0, sumProfit = 0, sumRemVal = 0;
      appState.items.forEach(i => {
        sumSales += i.sold * i.sellPrice;
        sumProfit += i.sold * (i.sellPrice - i.buyPrice);
        sumRemVal += i.remaining * i.buyPrice;
      });
      document.getElementById('closeDaySummaryPreview').innerHTML = `
        <div class="flex justify-between"><span>إجمالي البيع:</span><strong>${fmt(sumSales)} ج</strong></div>
        <div class="flex justify-between text-emerald-400"><span>صافي الربح (الممسي):</span><strong>${fmt(sumProfit)} ج</strong></div>
        <div class="flex justify-between text-purple-300"><span>قيمة المتبقي:</span><strong>${fmt(sumRemVal)} ج</strong></div>
      `;
      openModal('closeDayModal');
    }

    function confirmCloseAndSaveDay() {
      const date = document.getElementById('currentDateInput').value;
      const manager = document.getElementById('managerNameInput').value || 'مسؤول البوفيه';
      let sumSales = 0, sumProfit = 0, sumSoldCap = 0, sumRemVal = 0;
      const snap = appState.items.map(i => {
        sumSales += i.sold * i.sellPrice;
        sumSoldCap += i.sold * i.buyPrice;
        sumProfit += i.sold * (i.sellPrice - i.buyPrice);
        sumRemVal += i.remaining * i.buyPrice;
        return { ...i };
      });
      if (!Array.isArray(appState.history)) appState.history = [];
      appState.history.unshift({
        id: Date.now(), date, manager, notes: document.getElementById('closeDayNotes').value,
        totalSales: sumSales, netProfit: sumProfit, soldCapital: sumSoldCap,
        remainingStockValue: sumRemVal, requiredPurchase: Math.max(0, appState.targetCapital - sumRemVal), items: snap
      });
      if (document.getElementById('rolloverCheckbox').checked) {
        appState.items.forEach(i => { i.initial = i.remaining; i.added = 0; i.sold = 0; });
      }
      closeModal('closeDayModal');
      renderInventoryTable();
      renderHistoryLog();
      saveCurrentState();
      switchTab('historyTab', document.querySelectorAll('.tab-btn')[1]);
    }

    function renderHistoryLog() {
      const list = Array.isArray(appState.history) ? appState.history : [];
      document.getElementById('historyCountBadge').innerText = list.length;
      let totalP = 0;
      list.forEach(h => totalP += Number(h.netProfit || 0));
      document.getElementById('allDaysTotalProfit').innerText = `${fmt(totalP)} ج.م`;
      document.getElementById('historyListContainer').innerHTML = list.map(d => `
        <div class="glass rounded-2xl p-4 space-y-2">
          <div class="flex justify-between text-xs font-bold">
            <span class="text-emerald-400">${d.date} | ${d.manager}</span>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center text-xs">
            <div class="p-2 bg-slate-900 rounded-xl">البيع: <strong>${fmt(d.totalSales)}</strong></div>
            <div class="p-2 bg-emerald-950/40 rounded-xl text-emerald-400">الممسي: <strong>${fmt(d.netProfit)}</strong></div>
            <div class="p-2 bg-rose-950/40 rounded-xl text-rose-400">للشراء: <strong>${fmt(d.requiredPurchase)}</strong></div>
          </div>
        </div>
      `).join('');
    }

    function previewInvoiceImage(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const scale = img.width > 800 ? 800 / img.width : 1;
          canvas.width = img.width * scale;
          canvas.height = img.height * scale;
          canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
          tempInvoiceImageBase64 = canvas.toDataURL('image/jpeg', 0.7);
          const p = document.getElementById('invImagePreview');
          p.src = tempInvoiceImageBase64;
          p.classList.remove('hidden');
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function saveInvoice() {
      if (!Array.isArray(appState.invoices)) appState.invoices = [];
      appState.invoices.unshift({
        id: Date.now(),
        date: document.getElementById('currentDateInput').value,
        supplier: document.getElementById('invSupplier').value || 'فاتورة شراء',
        amount: Number(document.getElementById('invAmount').value || 0),
        buyer: document.getElementById('invBuyer').value || appState.managerName,
        image: tempInvoiceImageBase64
      });
      tempInvoiceImageBase64 = '';
      closeModal('addInvoiceModal');
      renderInvoices();
      saveCurrentState();
    }

    function renderInvoices() {
      const list = Array.isArray(appState.invoices) ? appState.invoices : [];
      document.getElementById('invoicesCountBadge').innerText = list.length;
      document.getElementById('invoicesGridContainer').innerHTML = list.map(inv => `
        <div class="glass rounded-2xl overflow-hidden p-3 space-y-2">
          ${inv.image ? `<img src="${inv.image}" onclick="showLightbox('${inv.image}')" class="h-36 w-full object-cover rounded-xl cursor-pointer" />` : ''}
          <div class="text-xs text-slate-400">${inv.date} | ${inv.buyer}</div>
          <div class="font-bold text-white">${inv.supplier}</div>
          <div class="font-black text-amber-400">${fmt(inv.amount)} ج.م</div>
        </div>
      `).join('');
    }

    function showLightbox(src) {
      document.getElementById('lightboxImg').src = src;
      openModal('imageLightbox');
    }

    function setAnalyticsMode(mode, btn) {
      currentAnalyticsMode = mode;
      renderAnalytics();
    }

    function renderAnalytics() {
      const map = {};
      const lists = currentAnalyticsMode === 'daily' ? [appState.items] : [appState.items, ...(appState.history || []).map(h => h.items || [])];
      let grandS = 0, grandP = 0;
      lists.forEach(l => (l || []).forEach(i => {
        if (!map[i.name]) map[i.name] = { name: i.name, soldQty: 0, profit: 0 };
        const s = Number(i.sold || 0) * Number(i.sellPrice || 0);
        const p = s - (Number(i.sold || 0) * Number(i.buyPrice || 0));
        map[i.name].soldQty += Number(i.sold || 0);
        map[i.name].profit += p;
        grandS += s; grandP += p;
      }));
      const arr = Object.values(map);
      const byP = [...arr].sort((a, b) => b.profit - a.profit);
      const byQ = [...arr].sort((a, b) => b.soldQty - a.soldQty);
      document.getElementById('statTopProfitItem').innerText = byP[0]?.name || '—';
      document.getElementById('statTopProfitVal').innerText = `${fmt(byP[0]?.profit || 0)} ج.م`;
      document.getElementById('statTopQtyItem').innerText = byQ[0]?.name || '—';
      document.getElementById('statTopQtyVal').innerText = `${byQ[0]?.soldQty || 0} قطعة`;
      document.getElementById('statAvgMargin').innerText = grandS > 0 ? `${((grandP / grandS) * 100).toFixed(1)}%` : '0%';

      const maxP = Math.max(1, byP[0]?.profit || 1);
      document.getElementById('chartProfitBars').innerHTML = byP.filter(i => i.profit > 0).map(i => `
        <div class="text-xs space-y-1">
          <div class="flex justify-between"><span>${i.name}</span><strong class="text-emerald-400">${fmt(i.profit)} ج</strong></div>
          <div class="w-full h-2 bg-slate-800 rounded-full"><div class="h-full bg-emerald-500 rounded-full" style="width:${(i.profit/maxP)*100}%"></div></div>
        </div>
      `).join('');

      const maxQ = Math.max(1, byQ[0]?.soldQty || 1);
      document.getElementById('chartQtyBars').innerHTML = byQ.filter(i => i.soldQty > 0).map(i => `
        <div class="text-xs space-y-1">
          <div class="flex justify-between"><span>${i.name}</span><strong class="text-blue-400">${i.soldQty} قطعة</strong></div>
          <div class="w-full h-2 bg-slate-800 rounded-full"><div class="h-full bg-blue-500 rounded-full" style="width:${(i.soldQty/maxQ)*100}%"></div></div>
        </div>
      `).join('');
    }

    function renderShoppingList(reqBuy) {
      const zeros = appState.items.filter(i => i.remaining <= 0);
      const lows = appState.items.filter(i => i.remaining > 0 && i.remaining <= 10);
      const all = [...zeros, ...lows];
      document.getElementById('lowStockBadge').innerText = all.length;
      document.getElementById('shopBudgetAvailable').innerText = `${fmt(reqBuy)} ج.م`;
      document.getElementById('shopZeroCount').innerText = `${zeros.length} أصناف`;
      document.getElementById('shopLowCount').innerText = `${lows.length} أصناف`;
      document.getElementById('lowStockListContainer').innerHTML = all.map(i => `
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex justify-between text-xs">
          <strong>${i.name}</strong>
          <span class="text-rose-400 font-bold">متبقي: ${i.remaining}</span>
        </div>
      `).join('');
    }

    function shareShoppingListWhatsApp() {
      const all = appState.items.filter(i => i.remaining <= 10);
      let txt = `*نواقص البوفيه (${appState.currentDate})*\n`;
      all.forEach((i, idx) => { txt += `${idx + 1}. ${i.name} (متبقي: ${i.remaining})\n`; });
      window.open(`https://wa.me/?text=${encodeURIComponent(txt)}`, '_blank');
    }

    function loadStateFromStorage() {
      const s = localStorage.getItem('buffet_pro_7070_state');
      if (s) { try { appState = { ...appState, ...JSON.parse(s) }; } catch (e) {} }
      appState.firebaseUrl = appState.firebaseUrl || DEFAULT_FIREBASE_URL;
      appState.firebaseShopKey = appState.firebaseShopKey || DEFAULT_SHOP_KEY;
    }

    function saveCurrentState() {
      appState.currentDate = document.getElementById('currentDateInput')?.value || appState.currentDate;
      appState.managerName = document.getElementById('managerNameInput')?.value || appState.managerName;
      localStorage.setItem('buffet_pro_7070_state', JSON.stringify(appState));
      pushToFirebaseSilent();
    }

    async function autoConnectFirebaseOnStart() {
      const url = (appState.firebaseUrl || DEFAULT_FIREBASE_URL).replace(/\/$/, '');
      const key = appState.firebaseShopKey || DEFAULT_SHOP_KEY;
      try {
        const res = await fetch(`${url}/${key}.json`);
        const data = await res.json();
        if (data && Array.isArray(data.items) && data.items.length > 0) {
          appState = { ...appState, ...data, firebaseUrl: url, firebaseShopKey: key };
          localStorage.setItem('buffet_pro_7070_state', JSON.stringify(appState));
          syncInputsWithState();
          renderInventoryTable();
          renderHistoryLog();
          renderInvoices();
        } else {
          await pushToFirebaseSilent();
        }
        setCloudBadgeStatus('connected');
      } catch (e) { setCloudBadgeStatus('error'); }
    }

    async function pushToFirebaseSilent() {
      const url = (appState.firebaseUrl || DEFAULT_FIREBASE_URL).replace(/\/$/, '');
      const key = appState.firebaseShopKey || DEFAULT_SHOP_KEY;
      try {
        const res = await fetch(`${url}/${key}.json`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(appState)
        });
        if (res.ok) setCloudBadgeStatus('connected');
      } catch (e) { setCloudBadgeStatus('error'); }
    }

    async function pullFromFirebase(showMsg = false) {
      await autoConnectFirebaseOnStart();
      if (showMsg) alert('تمت المزامنة مع سحابة Firebase بنجاح!');
    }

    function saveFirebaseConfig() {
      appState.firebaseUrl = document.getElementById('fbDbUrlInput').value.trim().replace(/\/$/, '') || DEFAULT_FIREBASE_URL;
      appState.firebaseShopKey = document.getElementById('fbShopKeyInput').value.trim() || DEFAULT_SHOP_KEY;
      saveCurrentState();
      closeModal('firebaseModal');
    }

    function setCloudBadgeStatus(st) {
      const b = document.getElementById('cloudStatusBadge');
      if (st === 'connected') {
        b.className = 'text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold';
        b.innerHTML = '<i class="fa-solid fa-cloud-bolt ml-1"></i>متصل بـ Firebase لحظياً';
      } else {
        b.className = 'text-xs px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold';
        b.innerHTML = '<i class="fa-solid fa-hard-drive ml-1"></i>حفظ محلي نشط';
      }
    }

    function downloadAppHTMLFile() {
      const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([html], { type: 'text/html;charset=utf-8' }));
      a.download = 'buffet_pro_7070.html';
      a.click();
    }

    function switchTab(tabId, btn) {
      ['dailyTab', 'historyTab', 'invoicesTab', 'analyticsTab', 'shoppingTab'].forEach(id => document.getElementById(id).classList.add('hidden'));
      document.getElementById(tabId).classList.remove('hidden');
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
  </script>

</body></html>