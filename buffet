<body class="min-h-screen pb-24">

  <!-- الشريط العلوي -->
  <header class="glass sticky top-0 z-40 border-b border-slate-800 px-4 py-3 no-print">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center shadow-lg shadow-emerald-900/40">
          <i class="fa-solid fa-mug-hot text-xl text-white"></i>
        </div>
        <div>
          <h1 class="text-lg md:text-xl font-black tracking-wide text-white flex items-center gap-2 flex-wrap">
            بوفيه برو الذكي
            <span id="cloudStatusBadge" class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold"><i class="fa-solid fa-cloud-bolt ml-1"></i>متصل بـ Firebase لحظياً</span>
          </h1>
          <p class="text-xs text-slate-400">إدارة رأس المال (7,070 ج.م) والجرد اليومي والفواتير والإحصائيات السحابية</p>
        </div>
      </div>

      <!-- أزرار التحكم السريع -->
      <div class="flex items-center gap-2 flex-wrap">
        <button onclick="openModal('capitalModal')" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-emerald-400 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-vault"></i>
          <span>رأس المال المستهدف: <strong id="headerTargetCapital">7,070</strong> ج</span>
          <i class="fa-solid fa-pen text-[10px] text-slate-400"></i>
        </button>

        <button onclick="pullFromFirebase(true)" class="px-3 py-2 rounded-xl bg-blue-500/15 hover:bg-blue-500/25 border border-blue-500/30 text-xs font-bold text-blue-300 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-arrows-rotate"></i>
          <span>تحديث لحظي</span>
        </button>

        <button onclick="openModal('firebaseModal')" class="px-3 py-2 rounded-xl bg-orange-500/15 hover:bg-orange-500/25 border border-orange-500/30 text-xs font-bold text-orange-300 flex items-center gap-1.5 transition">
          <i class="fa-solid fa-fire text-orange-400"></i>
          <span>ربط Firebase</span>
        </button>

        <button onclick="downloadAppHTMLFile()" class="px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-black text-white flex items-center gap-1.5 shadow-lg transition">
          <i class="fa-solid fa-download"></i>
          <span>تحميل كملف HTML</span>
        </button>
      </div>
    </div>

    <!-- شريط التبويبات -->
    <div class="max-w-7xl mx-auto mt-3 flex items-center gap-2 overflow-x-auto pb-1">
      <button onclick="switchTab('dailyTab', this)" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold text-slate-300 whitespace-nowrap flex items-center gap-2 transition active">
        <i class="fa-solid fa-table-list"></i> يومية التشغيل والجرد
      </button>
      <button onclick="switchTab('historyTab', this)" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold text-slate-300 whitespace-nowrap flex items-center gap-2 transition">
        <i class="fa-solid fa-calendar-check"></i> سجل اليوميات والتقفيل
        <span id="historyCountBadge" class="px-1.5 py-0.2 rounded-full bg-slate-900/60 text-[11px]">4</span>
      </button>
      <button onclick="switchTab('invoicesTab', this)" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold text-slate-300 whitespace-nowrap flex items-center gap-2 transition">
        <i class="fa-solid fa-file-invoice-dollar"></i> فواتير المشتريات المصورة
        <span id="invoicesCountBadge" class="px-1.5 py-0.2 rounded-full bg-slate-900/60 text-[11px]">1</span>
      </button>
      <button onclick="switchTab('analyticsTab', this)" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold text-slate-300 whitespace-nowrap flex items-center gap-2 transition">
        <i class="fa-solid fa-chart-pie"></i> إحصائيات المبيعات (يومي / شهري)
      </button>
      <button onclick="switchTab('shoppingTab', this)" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm font-bold text-slate-300 whitespace-nowrap flex items-center gap-2 transition">
        <i class="fa-solid fa-cart-shopping"></i> النواقص وطلبية الشراء الذكية
        <span id="lowStockBadge" class="px-1.5 py-0.2 rounded-full bg-rose-500 text-white text-[11px]">4</span>
      </button>
    </div>
  </header>

  <!-- المحتوى الرئيسي -->
  <main class="max-w-7xl mx-auto px-3 md:px-4 pt-4">

    <!-- التبويب 1: يومية التشغيل والجرد -->
    <section id="dailyTab" class="space-y-4">
      <div class="glass rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3 flex-1">
          <div>
            <label class="block text-[11px] text-slate-400 mb-1">تاريخ اليومية</label>
            <input type="date" id="currentDateInput" onchange="saveCurrentState()" class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm font-bold text-white focus:border-emerald-500 outline-none">
          </div>
          <div class="flex-1 min-w-[180px]">
            <label class="block text-[11px] text-slate-400 mb-1">المسؤول عن البوفيه اليوم</label>
            <div class="relative">
              <i class="fa-solid fa-user-tie absolute right-3 top-3 text-slate-400 text-xs"></i>
              <input type="text" id="managerNameInput" oninput="saveCurrentState()" placeholder="اكتب اسم مسؤول الوردية..." class="w-full bg-slate-900 border border-slate-700 rounded-xl pr-8 pl-3 py-2 text-sm font-bold text-white focus:border-emerald-500 outline-none">
            </div>
          </div>
          <div class="w-40">
            <label class="block text-[11px] text-slate-400 mb-1">كاش بظرف رأس المال (ج)</label>
            <input type="number" step="0.5" id="cashReserveInput" oninput="recalculateAll()" value="0" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm font-bold text-amber-300 text-center focus:border-emerald-500 outline-none">
          </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <button onclick="openProductModal()" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs md:text-sm flex items-center gap-2 shadow-lg shadow-emerald-900/40 transition">
            <i class="fa-solid fa-plus-circle"></i> إضافة صنف جديد (بالكرتونة/القطعة)
          </button>
          <button onclick="openCloseDayModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold text-xs md:text-sm flex items-center gap-2 shadow-lg shadow-indigo-900/40 transition">
            <i class="fa-solid fa-check-double"></i> تقفيل اليومية وترحيل الملخص
          </button>
        </div>
      </div>

      <!-- الكروت المالية الخمسة -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <div class="glass rounded-2xl p-4 border-r-4 border-r-blue-500">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>إجمالي البيع (الدرج)</span>
            <i class="fa-solid fa-cash-register text-blue-400"></i>
          </div>
          <div class="text-xl md:text-2xl font-black text-white" id="cardTotalSales">0.00 ج</div>
          <div class="text-[11px] text-slate-400 mt-1">كل الفلوس اللي دخلت اليوم</div>
        </div>

        <div class="glass rounded-2xl p-4 border-r-4 border-r-emerald-500 bg-emerald-950/20">
          <div class="flex items-center justify-between text-xs text-emerald-300 mb-1">
            <span class="font-bold">صافي الربح (الممسي)</span>
            <i class="fa-solid fa-sack-dollar text-emerald-400"></i>
          </div>
          <div class="text-xl md:text-2xl font-black text-emerald-400" id="cardNetProfit">0.00 ج</div>
          <div class="text-[11px] text-emerald-300/80 mt-1">تطلعه في جيبك بره الشغل</div>
        </div>

        <div class="glass rounded-2xl p-4 border-r-4 border-r-amber-500">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>رأس المال اللي بعت بيه</span>
            <i class="fa-solid fa-rotate text-amber-400"></i>
          </div>
          <div class="text-xl md:text-2xl font-black text-amber-300" id="cardSoldCapital">0.00 ج</div>
          <div class="text-[11px] text-slate-400 mt-1">الباقي من الدرج بعد طلوع الممسي</div>
        </div>

        <div class="glass rounded-2xl p-4 border-r-4 border-r-purple-500">
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span>بضاعة متبقية بالمحل</span>
            <i class="fa-solid fa-boxes-stacked text-purple-400"></i>
          </div>
          <div class="text-xl md:text-2xl font-black text-purple-300" id="cardRemainingStockValue">6,579.315 ج</div>
          <div class="text-[11px] text-slate-400 mt-1">مقومة بسعر الشراء الفعلي</div>
        </div>

        <div class="glass rounded-2xl p-4 border-r-4 border-r-rose-500 col-span-2 md:col-span-1 bg-rose-950/20">
          <div class="flex items-center justify-between text-xs text-rose-300 mb-1">
            <span class="font-bold">مطلوب شراء بضاعة بـ</span>
            <i class="fa-solid fa-truck-ramp-box text-rose-400"></i>
          </div>
          <div class="text-xl md:text-2xl font-black text-rose-400" id="cardRequiredPurchase">490.685 ج</div>
          <div class="text-[11px] text-rose-300/80 mt-1" id="cardCapitalStatusSub">ليرجع البوفيه 7,070 ج بضاعة</div>
        </div>
      </div>

      <!-- ميزان رأس المال -->
      <div class="glass rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3 border border-slate-700/80">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center text-emerald-400">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <div class="text-xs md:text-sm">
            <span class="text-slate-300">ميزان رأس مال البوفيه اليوم (بضاعة متبقية + رأس مال مباع + كاش الظرف): </span>
            <strong id="totalActualCapitalDisplay" class="text-white font-black text-base mr-1">6,729.315 ج.م</strong>
            <span id="capitalDiffBadge" class="mr-2 px-2.5 py-0.5 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-300">الفرق عن المستهدف: -340.685 ج</span>
          </div>
        </div>
      </div>

      <!-- بحث وتوريد سريع -->
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="relative flex-1 min-w-[220px]">
          <i class="fa-solid fa-magnifying-glass absolute right-3.5 top-3 text-slate-400 text-xs"></i>
          <input type="text" id="searchItemInput" oninput="renderInventoryTable()" placeholder="ابحث عن صنف بسرعة (مثال: ستينج، شاي، تايجر...)" class="w-full glass rounded-xl pr-9 pl-4 py-2 text-xs md:text-sm text-white focus:border-emerald-500 outline-none">
        </div>
        <div class="flex items-center gap-2">
          <button onclick="quickAddCartonModal()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-amber-300 flex items-center gap-1.5">
            <i class="fa-solid fa-box-open"></i> توريد بضاعة بالكرتونة
          </button>
          <button onclick="window.print()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-slate-300 flex items-center gap-1.5">
            <i class="fa-solid fa-print"></i> طباعة اليومية
          </button>
